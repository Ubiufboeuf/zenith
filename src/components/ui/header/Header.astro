---
import { Notifications } from '@/components/notifications/Notifications'
import { UserProfile } from '../../user/UserProfile'
import { ServerStatusBadge } from './ServerStatusBadge'
import { Button } from '../Button'
import { Icon } from '../Icon'
import { IconMenu } from '../Icons'
---

<header class='sticky top-0 right-0 h-16 w-full px-4 flex items-center justify-between border-b border-b-neutral-700 bg-base-100'>
  <div class='w-fit flex items-center gap-2'>
    <Button id='sidebar-button' fill='ghost' shape='square' className='md:hidden'>
      <Icon class='size-4'>
        <IconMenu />
      </Icon>
    </Button>
    Buscador
  </div>
  <div class='w-fit flex items-center gap-2'>
    <ServerStatusBadge />
    <Notifications client:load />
    <UserProfile client:load />
  </div>
</header>

<script>
  const button = document.querySelector('#sidebar-button')
  const sidebarCheckbox = document.querySelector('#sidebar-checkbox') as HTMLInputElement
  
  let lastCheckboxValue: boolean | null = null

  button?.addEventListener('click', () => {
    if (lastCheckboxValue === null || lastCheckboxValue !== sidebarCheckbox.checked) {
      lastCheckboxValue = sidebarCheckbox.checked
    }

    const newValue = !lastCheckboxValue

    sidebarCheckbox.checked = newValue
  })
</script>