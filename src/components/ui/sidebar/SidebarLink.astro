---
import type { SidebarLink } from '@/types/ui/sidebarTypes'
import { Icon } from '../Icon'

type Props = SidebarLink

const { name, path, icon: LinkIcon } = Astro.props
const { pathname } = Astro.url

const currentPath = pathname === path
---

<a href={path} class={`${currentPath ? 'currentPath' : ''} w-full h-9 flex items-center px-3 gap-2 rounded transition-colors text-primary-content shr:bg-base-content/10 [.currentPath]:bg-base-content/10 shr:[.currentPath]:bg-base-content/20`}>
  { LinkIcon && (
    <Icon class='size-5 stroke-2' style={{ strokeLinecap: 'round', strokeLinejoin: 'round' }}>
      <LinkIcon />
    </Icon>
  ) }
  <span class='text-sm'>
    {name}
  </span>
</a>