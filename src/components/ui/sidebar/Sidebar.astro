---
import { SIDEBAR_SECTIONS } from '@/constants/ui/sidebarConstants'
import SidebarSection from './SidebarSection.astro'
import { LinkButton } from '../LinkButton'
import { Themes } from '../Themes'

const themeCookie = Astro.cookies.get('_znt-thm')
const theme = themeCookie?.value ?? 'dark'
---

<input id='sidebar-checkbox' type='checkbox' class='peer' hidden />
<aside class='mobile:hidden z-20 fixed not-md:-left-sidebar not-md:hidden not-sidebar:-left-sidebar not-sidebar:hidden peer-checked:left-0 peer-checked:flex top-16 sidebar:md:top-0 h-[calc(100%-64px)] md:sidebar:h-full w-sidebar flex flex-col overflow-y-auto scrollbar-gutter-stable border-r border-base-content/20 bg-base-100 transition-[left,display] peer-checked:starting:-left-sidebar transition-discrete'>
  <div class='h-full min-h-fit w-full flex flex-1 flex-col gap-2 p-3 py-4'>
    <div class='pb-4'>
      <LinkButton href='/sales/new' width='block' color='primary' fill='soft'>Nueva venta</LinkButton>
    </div>
    { SIDEBAR_SECTIONS.map((section) => <SidebarSection {...section} />) }
  </div>
  <div class='relative w-full h-min p-3 py-4'>
    <Themes
      initialTheme={theme}
      btnClass='w-full'
      class='left-2 bottom-15 w-fit'
      client:load
    />
  </div>
</aside>
<button id='close-sidebar' class='z-18 peer-checked:not-md:block peer-checked:not-sidebar:block hidden fixed w-full h-full bg-black/50' />

<script>
  const button = document.querySelector('#close-sidebar')
  const sidebarCheckbox = document.querySelector('#sidebar-checkbox') as HTMLInputElement
  
  let lastCheckboxValue: boolean | null = null

  button?.addEventListener('click', () => {
    if (lastCheckboxValue === null || lastCheckboxValue !== sidebarCheckbox.checked) {
      lastCheckboxValue = sidebarCheckbox.checked
    }

    const newValue = !lastCheckboxValue

    sidebarCheckbox.checked = newValue
  })
</script>