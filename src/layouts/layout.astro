---
import '../styles/global.css'
import Sidebar from '@/components/ui/sidebar/Sidebar.astro'
import Header from '@/components/ui/header/Header.astro'

interface Props {
	title?: string
	scrollbarGutter?: 'auto' | 'both' | 'stable'
	class?: string
}

const { title, scrollbarGutter = 'auto', class: className = '' } = Astro.props
---

<html lang='es' style={`scrollbar-gutter: ${scrollbarGutter}`}>
	<head>
		<meta charset='utf-8' />
		<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
		<link rel='icon' href='/favicon.ico' />
		<meta name='viewport' content='width=device-width' />
		<title>{title ? `${title} - Zenith` : 'Zenith'}</title>
		<link rel='preload' href='/Inter.woff2' as='font' type='font/woff2' crossorigin />
	</head>
	<body>
		<Sidebar />
		<div class='w-full h-full min-h-fit md:pl-sidebar bg-base-200'>
			<Header />
			<main class={`${className} flex flex-col w-full max-w-6xl h-[calc(100%-64px)] min-h-fit mx-auto`}>
				<slot />
			</main>
		</div>
	</body>
</html>
