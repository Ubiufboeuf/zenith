---
import '../styles/global.css'
import Sidebar from '@/components/ui/sidebar/Sidebar.astro'
import Header from '@/components/ui/header/Header.astro'
import { TabBar } from '@/components/ui/tabBar/TabBar'
import { MobileSearchBar } from '@/components/ui/mobile/MobileSearchBar'

interface Props {
	title?: string
	scrollbarGutter?: 'auto' | 'both' | 'stable'
	class?: string
	containerClass?: string
	sidebar?: boolean
}

const { title, scrollbarGutter = 'auto', class: className = '', containerClass = '', sidebar = true } = Astro.props
const currentPath = Astro.url.pathname


// #region - detectDeviceType
const deviceCode = Astro.cookies.get('_znt-dvctp')?.value
const ua = Astro.request.headers.get('user-agent') || ''

const mobileRegex = /(Mobi|Android(?!.*Nexus 7)|iPhone|iPod|Windows Phone|BlackBerry|Symbian|IEMobile|Opera Mini|Fennec|webOS|hpwos|avantgo|bada|blazer|compal|elaine|hiptop|kindle|lge|maemo|midp|mmp|netfront|palm|phone|plucker|pocket|psp|series60|treo|up\.browser|up\.link|vodafone|wap|windows ce|xda|xiino)/i

let detectedType = 'desktop'
if (mobileRegex.test(ua)) detectedType = 'mobile'

const devices: Record<string, string> = { M: 'mobile', D: 'desktop' }
const deviceType = devices[deviceCode!] || detectedType
// #endregion

// SEO
const lastUpdate = new Date().toISOString().split('T')[0]
const url = Astro.url.href
const pageTitle = title ? `${title} - Zenith - mAngo (Ubiufboeuf)` : 'Zenith - mAngo (Ubiufboeuf)'
const description = "Sistema de ventas con gestión de inventario y clientes, diseñado para superar las limitaciones habituales del software de gestión.";
const imageURL = "https://zenith-delta-dusky.vercel.app/preview.webp";
---

<html
	lang='es'
	style={`scrollbar-gutter: ${scrollbarGutter}`}
	data-sidebar={sidebar ? 'true' : 'false'}
	data-device-type={deviceType}
>
	<head>
		<meta charset='utf-8' />
		<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
		<link rel='icon' href='/favicon.ico' />
		<meta name='viewport' content='width=device-width' />
		<title>{pageTitle}</title>

		<meta name="description" content={description} />
    <meta name="author" content="Federico Artencio" />

    <link rel="canonical" href={url} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="google-site-verification" content="Aw3cGucJEnizdS4mK6JC74MdcYiLCaFrdDQ1OFrloXk" />

    <meta property="og:type" content="website">
    <meta property="og:url" content={url}>
    <meta property="og:title" content={pageTitle}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={imageURL}>
    <meta property="og:image:alt" content="Vista previa del proyecto">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content={url}>
    <meta name="twitter:title" content={pageTitle}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={imageURL}>
  
    <meta property="article:published_time" content="2026-07-01">
    <meta property="article:modified_time" content={lastUpdate}>
    <meta name="theme-color" content="#191E24">

    <link rel="preload" href="/Inter.woff2" as="font" type="font/woff2" crossorigin />

		<script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "Zenith",
        "operatingSystem": "All",
        "applicationCategory": "PointOfSale",
        "offers": {
          "@type": "Offer",
          "price": "0"
        },
        "author": {
          "@type": "Person",
          "name": "Federico Artencio",
          "url": "https://portafolio-dej.pages.dev/"
        }
      }
    </script>
	</head>
	<body class='flex flex-col'>
		<Sidebar />
		<div class={`${containerClass} w-full h-full mobile:flex-1 mobile:min-h-0 sidebar:md:pl-sidebar bg-base-200`}>
			<Header />
			<MobileSearchBar client:load />
			<main class={`${className} flex flex-col w-full h-[calc(100%-64px)] mobile:h-full min-h-fit mx-auto`}>
				<slot />
			</main>
		</div>
		<TabBar currentPath={currentPath} client:load />
	</body>
</html>
