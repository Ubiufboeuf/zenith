---
import { KPIs } from '@/components/dashboard/KPIs'
import { LowStock } from '@/components/dashboard/LowStock'
import { TodaySalesCard } from '@/components/dashboard/TodaySalesCard'
import { TopProductsCard } from '@/components/dashboard/TopProductsCard'
import { WeeklySalesChart } from '@/components/dashboard/WeeklySalesChart'
import { MobileLowStock } from '@/components/ui/mobile/MobileLowStock'
import { MobileTodaySalesCard } from '@/components/ui/mobile/MobileTodaySalesCard'
import Layout from '@/layouts/layout.astro'
---

<Layout title='Inicio' containerClass='min-h-0!' class='p-4 gap-6 mobile:gap-2'>
  <section class='h-fit w-full'>
    <KPIs client:load />
  </section>
  <section class='mobile:hidden h-80 w-full grid grid-cols-[1.4fr_1fr_1fr_1fr] gap-6 *:card'>
    <div class='col-1 h-full overflow-hidden border border-base-content/20 bg-base-100'>
      <TodaySalesCard client:load />
    </div>
    <div class='col-[2/-1] h-full border border-base-content/20 bg-base-100 overflow-hidden'>
      <WeeklySalesChart client:load />
    </div>
  </section>
  <section class='mobile:hidden h-80 w-full grid grid-cols-2 items-center gap-6'>
    <LowStock client:load />
    <TopProductsCard client:load />
  </section>
  <section class='desktop:hidden h-full flex-1 flex flex-col items-center overflow-hidden'>
    <div class='w-full h-full max-h-full overflow-scroll flex flex-row overflow-x-auto overflow-y-scroll border border-base-content/20 bg-base-100'>
      <!-- <div class='h-[2000px]'></div> -->
      <MobileTodaySalesCard client:load />
      <MobileLowStock client:load />
    </div>
  </section>
</Layout>